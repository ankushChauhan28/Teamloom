# Database Configuration
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_task_db

# Security & JWT Configuration
# Generate secure keys via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme_some_long_random_hex_string_for_access_token
JWT_REFRESH_SECRET_KEY=changeme_another_long_random_hex_string_for_refresh_token
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (JSON array of origins)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
