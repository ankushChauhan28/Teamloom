# Database Service Credentials (used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=employee_task_db

# Database Connection URL (Async Engine with asyncpg)
# For local running (outside Docker): postgresql+asyncpg://postgres:postgres@localhost:5432/employee_task_db
# For Docker Compose: postgresql+asyncpg://postgres:postgres@db:5432/employee_task_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/employee_task_db

# Test Database Connection URL (Used by pytest test suite)
# Local Docker default: postgresql+asyncpg://postgres:postgres@localhost:5433/employee_task_test_db
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/employee_task_test_db

# Security & JWT Configuration
# Generate secure keys via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme_some_long_random_hex_string_for_access_token
JWT_REFRESH_SECRET_KEY=changeme_another_long_random_hex_string_for_refresh_token
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (JSON array of origins)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173"]

# Trusted Proxy IPs for rate limiting (comma-separated list, set only if behind Nginx/Cloudflare/load balancer)
TRUSTED_PROXY_IPS=

# Rate Limiting Configuration
# RATE_LIMITER_BACKEND: "memory" (default for single-instance/dev) | "redis" (MANDATORY for multi-worker/multi-node production)
# PRODUCTION DEPLOYMENT CHECKLIST ITEM: Must set RATE_LIMITER_BACKEND=redis in production to avoid multi-worker rate-limit bypass.
RATE_LIMITER_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# SMTP Email Configuration (for sending welcome emails & temp passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_digit_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
FRONTEND_URL=http://localhost:5173

